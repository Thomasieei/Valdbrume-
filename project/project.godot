; Valdbrume — projet Godot 4.7 (Android, rendu Mobile)

config_version=5

[application]

config/name="Valdbrume"
config/description="Ville de départ"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

AnimBank="*res://scripts/anim_bank.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=2
anti_aliasing/quality/msaa_3d=1
occlusion_culling/use_occlusion_culling=true
occlusion_culling/occluders_per_frame_budget=0
mesh_lod/lod_change/threshold_pixels=1.5
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
lights_and_shadows/positional_shadow/atlas_size=1024
reflections/sky_reflections/roughness_layers=6
reflections/sky_reflections/ggx_samples.mobile=16
environment/defaults/default_clear_color=Color(0.6, 0.7, 0.85, 1)
